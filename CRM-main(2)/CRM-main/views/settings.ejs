<%- include('layout/header', { title: 'Settings', pageTitle: 'Application Settings', activePage: 'settings' }) %>

<div style="max-width: 720px;">

  <!-- BUSINESS PROFILE SETTINGS -->
  <div class="card">
    <div class="card-header">
      <div class="card-title">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
        </svg>
        <span>Business Information</span>
      </div>
    </div>
    
    <form action="/settings" method="POST">
      <div class="card-body">
        
        <div class="form-group">
          <label class="form-label" for="setting_business_name">Business Name <span class="required">*</span></label>
          <input type="text" id="setting_business_name" name="business_name" class="form-control" value="<%= settings.business_name %>" required>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="setting_owner_email">Contact Email <span class="required">*</span></label>
            <input type="email" id="setting_owner_email" name="owner_email" class="form-control" value="<%= settings.owner_email %>" required>
          </div>
          <div class="form-group">
            <label class="form-label" for="setting_owner_phone">Contact Phone <span class="required">*</span></label>
            <input type="tel" id="setting_owner_phone" name="owner_phone" class="form-control" value="<%= settings.owner_phone %>" required>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="setting_currency">Currency Symbol</label>
            <input type="text" id="setting_currency" name="currency" class="form-control" value="<%= settings.currency || '₹' %>" style="max-width: 140px;">
          </div>
          <div class="form-group">
            <label class="form-label" for="setting_theme">Interface Theme</label>
            <select id="setting_theme" name="theme" class="form-control">
              <option value="light" <%= settings.theme === 'light' ? 'selected' : '' %>>Modern Clean SaaS Light</option>
              <option value="indigo" <%= settings.theme === 'indigo' ? 'selected' : '' %>>Indigo Professional</option>
            </select>
          </div>
        </div>

      </div>

      <div class="card-footer">
        <button type="submit" class="btn btn-primary">Save Settings</button>
      </div>
    </form>
  </div>

  <!-- DEMO TOOLS: RESET SAMPLE DATA -->
  <div class="card" style="border-color: #fde68a;">
    <div class="card-header" style="background-color: #fffbeb;">
      <div class="card-title" style="color: #92400e;">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        <span>Demo Utility: Re-seed Sample Data</span>
      </div>
    </div>
    <div class="card-body">
      <p style="font-size: 0.88rem; color: #475569; margin-bottom: 14px; line-height: 1.5;">
        Need to reset the database back to clean sample data?
        Clicking this button repopulates the 10 standard demo customers, 15+ interactions, and scheduled follow-ups.
      </p>
      <form action="/reset-database" method="POST" onsubmit="return confirm('Reset all data back to default sample records? Any newly added test records will be refreshed.');">
        <button type="submit" class="btn btn-secondary" style="border-color: #f59e0b; color: #b45309;">
          ↻ Reset Database to Sample Records
        </button>
      </form>
    </div>
  </div>

  <!-- PROJECT CODE EXPORT & DOWNLOAD -->
  <div class="card" style="border-color: #bfdbfe;">
    <div class="card-header" style="background-color: #eff6ff;">
      <div class="card-title" style="color: #1e40af;">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
        </svg>
        <span>Download Complete Project</span>
      </div>
    </div>
    <div class="card-body">
      <p style="font-size: 0.88rem; color: #475569; margin-bottom: 14px; line-height: 1.5;">
        Download the entire project source code packaged into a clean, ready-to-run ZIP archive.
      </p>
      
      <div style="margin-bottom: 16px;">
        <a href="/download-project-zip" class="btn btn-primary" style="padding: 10px 20px; font-weight: 600;">
          <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
          <span>Download Project as ZIP (.zip)</span>
        </a>
      </div>
    </div>
  </div>

  <!-- System Info Card -->
  <div class="card">
    <div class="card-body" style="font-size: 0.84rem; color: #64748b; line-height: 1.6;">
      <div style="font-weight: 600; color: #1e293b; margin-bottom: 4px;">CRM Application</div>
      <div>Technology Stack: Node.js, Express, EJS, Vanilla CSS3 & JS</div>
      <div>High-performance in-memory persistence and modular responsive UI.</div>
    </div>
  </div>

</div>

<%- include('layout/footer') %>
