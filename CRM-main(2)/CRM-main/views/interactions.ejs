<%- include('layout/header', { title: 'Interactions Log', pageTitle: 'Customer Interactions', activePage: 'interactions' }) %>

<!-- FILTER & ACTION BAR -->
<div class="card" style="margin-bottom: 20px;">
  <div class="card-body" style="padding: 16px 20px;">
    <div class="table-header-bar" style="margin-bottom: 0;">
      
      <!-- Instant Client Search -->
      <div class="search-box">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <input 
          type="text" 
          id="clientTableSearch"
          class="search-input" 
          placeholder="Search interactions by customer or notes..." 
        >
      </div>

      <!-- Type Filter Tabs -->
      <div class="filter-group">
        <a href="/interactions?type=All" 
           class="filter-tab <%= typeFilter === 'All' || !typeFilter ? 'active' : '' %>">
          All
        </a>
        <a href="/interactions?type=Call" 
           class="filter-tab <%= typeFilter === 'Call' ? 'active' : '' %>">
          Calls
        </a>
        <a href="/interactions?type=Email" 
           class="filter-tab <%= typeFilter === 'Email' ? 'active' : '' %>">
          Emails
        </a>
        <a href="/interactions?type=Meeting" 
           class="filter-tab <%= typeFilter === 'Meeting' ? 'active' : '' %>">
          Meetings
        </a>
        <a href="/interactions?type=WhatsApp" 
           class="filter-tab <%= typeFilter === 'WhatsApp' ? 'active' : '' %>">
          WhatsApp
        </a>
      </div>

      <!-- Action Button -->
      <div>
        <button type="button" class="btn btn-primary" data-modal-open="logInteractionModal">
          <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          <span>+ Log Interaction</span>
        </button>
      </div>

    </div>
  </div>
</div>

<!-- INTERACTIONS LOG TABLE -->
<div class="card">
  <div class="card-header">
    <div class="card-title">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
      </svg>
      <span>Customer Activity Timeline (<%= interactions.length %> Records)</span>
    </div>
  </div>

  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr>
          <th>Customer</th>
          <th>Type</th>
          <th>Date</th>
          <th>Description / Details</th>
          <th>Follow-up Date</th>
          <th style="text-align: right;">Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (interactions && interactions.length > 0) { %>
          <% interactions.forEach(item => { %>
            <tr>
              <td>
                <div style="font-weight: 600;">
                  <a href="/customers/<%= item.customer_id %>">
                    <%= item.customer_name %>
                  </a>
                </div>
                <div style="font-size: 0.74rem; color: #64748b;">
                  <%= item.customer_company || 'Direct Client' %>
                </div>
              </td>
              <td>
                <span class="badge badge-default" style="font-weight: 600;"><%= item.type %></span>
              </td>
              <td style="font-size: 0.84rem; color: #475569; white-space: nowrap;">
                <%= item.interaction_date %>
              </td>
              <td style="font-size: 0.88rem; color: #1e293b; max-width: 380px;">
                <%= item.description %>
              </td>
              <td style="font-size: 0.82rem; color: #64748b; white-space: nowrap;">
                <%= item.follow_up_date || '-' %>
              </td>
              <td style="text-align: right; white-space: nowrap;">
                <button 
                  type="button" 
                  class="btn btn-icon danger btn-confirm-delete"
                  data-action="/interactions/delete/<%= item.id %>"
                  data-title="interaction with <%= item.customer_name %>"
                  title="Delete Interaction"
                >
                  <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                </button>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr class="no-records-row">
            <td colspan="6">
              <div class="empty-state">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                </svg>
                <h4>No Interactions Found</h4>
                <p>No communication records match this filter.</p>
                <button type="button" class="btn btn-primary btn-sm" data-modal-open="logInteractionModal">
                  + Log Interaction
                </button>
              </div>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- LOG INTERACTION MODAL -->
<div class="modal-overlay" id="logInteractionModal">
  <div class="modal-dialog">
    <div class="modal-header">
      <h3 class="modal-title">+ Log Customer Communication</h3>
      <button type="button" class="modal-close-btn" data-modal-close>&times;</button>
    </div>
    <form action="/interactions/add" method="POST">
      <div class="modal-body">
        
        <div class="form-group">
          <label class="form-label" for="log_inter_customer">Select Customer <span class="required">*</span></label>
          <select id="log_inter_customer" name="customer_id" class="form-control" required>
            <option value="" disabled selected>-- Choose Customer --</option>
            <% customers.forEach(cust => { %>
              <option value="<%= cust.id %>"><%= cust.name %> (<%= cust.company || 'Direct' %>)</option>
            <% }); %>
          </select>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="log_inter_type">Interaction Type <span class="required">*</span></label>
            <select id="log_inter_type" name="type" class="form-control" required>
              <option value="Call" selected>Phone Call</option>
              <option value="Email">Email</option>
              <option value="Meeting">In-Person / Virtual Meeting</option>
              <option value="WhatsApp">WhatsApp Message</option>
              <option value="Other">Other Channel</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label" for="log_inter_date">Date</label>
            <input type="date" id="log_inter_date" name="interaction_date" class="form-control">
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="log_inter_desc">Discussion Notes <span class="required">*</span></label>
          <textarea id="log_inter_desc" name="description" class="form-control" placeholder="Summary of call/email conversation, agreements reached, customer sentiment..." required></textarea>
        </div>

        <div class="form-group">
          <label class="form-label" for="log_inter_fu_date">Scheduled Follow-up Date (Optional)</label>
          <input type="date" id="log_inter_fu_date" name="follow_up_date" class="form-control">
          <span style="font-size: 0.72rem; color: #64748b;">If specified, an entry will automatically be added to your Follow-ups list.</span>
        </div>

      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-modal-close>Cancel</button>
        <button type="submit" class="btn btn-primary">Log Interaction</button>
      </div>
    </form>
  </div>
</div>

<%- include('layout/footer') %>
